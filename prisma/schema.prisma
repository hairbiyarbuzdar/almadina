// Prisma 7 schema — uses the new `prisma-client` generator + driver adapter.
// Connection URL is provided via prisma.config.ts (CLI) and the pg adapter (runtime).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  price       Int // PKR, whole rupees
  wasPrice    Int?
  badge       String?
  stock       Int         @default(0)
  optionName  String?
  variants    ProductVariant[]
  rating      Int         @default(5)
  image       String // e.g. /uploads/products/xyz.jpg
  blurb       String
  size        String
  description String
  benefits    String[]
  ingredients Json // [{ name, note }]
  howToUse    String
  active      Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  image     String?
  price     Int? // null inherits the product price
  stock     Int      @default(0)
  active    Boolean  @default(true)
  position  Int      @default(0)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId, active, position])
}

model Order {
  id        String      @id @default(cuid())
  number    Int         @unique @default(autoincrement())
  name      String
  phone     String
  address   String
  city      String
  subtotal      Int
  status        String      @default("pending") // pending | confirmed | delivered | cancelled
  paymentMethod String      @default("cod") // cod | online
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String // snapshot of product name at purchase time
  price     Int // snapshot of price
  qty       Int
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String? // snapshot: e.g. Shade: Ruby Red
}
